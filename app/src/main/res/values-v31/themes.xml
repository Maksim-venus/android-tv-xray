<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform splash on API 31+. The activity window underneath still uses splash_window. -->
    <style name="Theme.Passwall.Splash" parent="Theme.Passwall">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowSplashScreenBackground">#F5F5F7</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F5F5F7</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
