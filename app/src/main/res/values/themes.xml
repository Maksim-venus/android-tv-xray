<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Passwall" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">#F5F5F7</item>
        <item name="android:colorBackground">#F5F5F7</item>
        <item name="android:statusBarColor">#F5F5F7</item>
        <item name="android:navigationBarColor">#F5F5F7</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Starting window. Shown by the system before the first Compose frame, including API 24. -->
    <style name="Theme.Passwall.Splash" parent="Theme.Passwall">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
</resources>
